# ALTR promo sender config — copy to config.env and fill in.
# config.env is gitignored; never commit real credentials.

# --- SMTP (your email provider's sending credentials) ---
# Google Workspace: smtp.gmail.com / 587 / app password (not your login password)
# Zoho: smtp.zoho.com / 465 · Fastmail: smtp.fastmail.com / 465
# ESP SMTP relays (recommended at volume): SendGrid, Postmark, Mailgun, Resend
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=outreach@yourdomain.com
SMTP_PASS=your-app-password-here

# --- sender identity ---
FROM_EMAIL=outreach@yourdomain.com
FROM_NAME=Derrek at ALTR

# --- message ---
# Subject supports the same placeholders as the templates, e.g. {{first_name}}
SUBJECT={{first_name}}, stop risking your main page for a link that gets flagged
CTA_URL=https://your-booking-link.example.com
# {email} is swapped per-recipient. Point at a real opt-out (form, or mailto:)
UNSUBSCRIBE_URL=https://yourdomain.com/unsubscribe?e={email}
# Physical mailing address — required by CAN-SPAM. PO box / registered agent is fine.
COMPANY_ADDRESS=123 Example St, Suite 4, Los Angeles, CA 90000

# --- pacing (seconds between sends; randomized in this range) ---
DELAY_SECONDS_MIN=20
DELAY_SECONDS_MAX=45
