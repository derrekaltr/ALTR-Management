# ---- Content Snare OAuth app (create under avatar > Integrations > API) ----
# Redirect URL for the app must be: http://localhost:8484/callback
CS_CLIENT_ID=
CS_CLIENT_SECRET=

# ---- Claude API (used to auto-generate content ideas) ----
# Leave blank if you only use ideas_override/ files (e.g. pasted from GPTease)
ANTHROPIC_API_KEY=

# ---- Content Snare template names (must exist in your account, one per tier) ----
CS_TEMPLATE_NON_NUDE=Content Drop — Non Nude
CS_TEMPLATE_TOPLESS=Content Drop — Topless
CS_TEMPLATE_FULL_NUDE=Content Drop — Full Nude

# ---- Reminder schedule (Content Snare "communications schedule" name) ----
# "Default" uses your account's default reminder schedule
CS_COMMUNICATION_TEMPLATE=Default

# ---- Organization ----
CS_FOLDER_NAME=Monthly Content Drops
