# Postgres connection. Local dev default matches `npm run db:start` (embedded postgres)
# and docker-compose.yml. Prod: your Neon connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5502/trial_reels"

# Admin login (shared team password) and cookie signing secret (any long random string).
ADMIN_PASSWORD="change-me"
SESSION_SECRET="change-me-to-a-long-random-string"

# Anthropic API. Leave ANTHROPIC_API_KEY empty (or set LLM_MOCK=1) to use the
# deterministic mock provider — the whole app works without credentials.
ANTHROPIC_API_KEY=""
LLM_MODEL="claude-sonnet-5"
LLM_MOCK=""

# Vercel Blob. Empty locally = videos/frames are stored under public/uploads/.
BLOB_READ_WRITE_TOKEN=""
