# Claude credential (alternatively run `ant auth login`)
ANTHROPIC_API_KEY=

# Meta app (Business type) → Instagram → "API setup with Instagram business login"
IG_APP_ID=
IG_APP_SECRET=
# Must exactly match a "Valid OAuth Redirect URI" in the app. For creators on phones, tunnel it: ngrok http 3000 → https://xxxx.ngrok.app/callback
IG_REDIRECT_URI=http://localhost:3000/callback
# Optional override of requested scopes
# IG_SCOPES=instagram_business_basic,instagram_business_manage_insights

# Legacy single-account path (Facebook Login user token for a Page-linked account)
IG_ACCESS_TOKEN=
IG_USER_ID=
