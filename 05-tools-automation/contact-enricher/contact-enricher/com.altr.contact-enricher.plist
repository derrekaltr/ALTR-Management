<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.altr.contact-enricher</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__BASE_DIR__/run.sh</string>
        <string>--apply</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>__BASE_DIR__/data/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__BASE_DIR__/data/logs/launchd.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
