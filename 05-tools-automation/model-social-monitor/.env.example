# Copy this file to .env and fill in your real keys. Never commit .env.

# Apify API token — https://console.apify.com/settings/integrations
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telegram bot token — from @BotFather (see SETUP.md)
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides
# STATE_DB_PATH=data/state.db
# LOG_LEVEL=INFO
